{%- assign key = page.edition | default: site.current_edition -%}
{%- assign ed = site.data.editions[key] -%}
{%- assign day = ed.date | date: '%Y%m%d' -%}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//TU/e EES//Research Day//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VTIMEZONE
TZID:Europe/Amsterdam
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:ees-research-day-{{ key }}@ees-tue.github.io
DTSTAMP:{{ site.time | date: '%Y%m%dT%H%M%SZ' }}
DTSTART;TZID=Europe/Amsterdam:{{ day }}T{{ ed.start_time | remove: ':' }}00
DTEND;TZID=Europe/Amsterdam:{{ day }}T{{ ed.end_time | remove: ':' }}00
SUMMARY:EES Research Day {{ ed.year }}
LOCATION:{{ ed.venue.name | replace: ',', '\,' }}\, {{ ed.venue.address | replace: ',', '\,' }}
URL:{{ '/' | append: key | append: '/' | absolute_url }}
DESCRIPTION:Programme: {{ '/' | append: key | append: '/' | absolute_url }}
END:VEVENT
END:VCALENDAR
